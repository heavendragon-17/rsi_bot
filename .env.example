# ============================================================
# RSI Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# --- Binance (USDT-M Futures) ---

# Testnet keys — used in 'paper' mode (bot.mode: paper)
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_key_here

# Mainnet keys — used in 'live' mode (bot.mode: live) — REAL MONEY
BINANCE_API_KEY=your_mainnet_api_key_here
BINANCE_SECRET_KEY=your_mainnet_secret_key_here

# --- Telegram Notifications ---

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat/channel ID to send messages to
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Lighter DEX (optional) ---
# Only needed if exchange.name = 'lighter' in config.yaml

# LIGHTER_SECRET_KEY=your_lighter_private_key_here
# LIGHTER_ACCOUNT_INDEX=0
# LIGHTER_L1_ADDRESS=your_wallet_address_here
# LIGHTER_API_KEY_INDEX=2
# LIGHTER_BASE_URL=

# --- Hyperliquid (optional, placeholder) ---
# HYPERLIQUID_PRIVATE_KEY=your_wallet_private_key_here

# --- Paper Sim Overrides (optional) ---
# Override Telegram credentials for paper/sim mode notifications.
# Leave blank to reuse TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID.

# PAPER_TELEGRAM_BOT_TOKEN=
# PAPER_TELEGRAM_CHAT_ID=

# --- Testing ---
# Set to 1 to enable live Binance integration tests (requires real API keys)
# RUN_INTEGRATION_TESTS=0
