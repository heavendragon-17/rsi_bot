                180
              ],
              "type": "integer"
            },
            "mode": {
              "enum": [
                "fixture",
                "real"
              ],
              "type": "string"
            }
          },
          "required": [
            "mode",
            "horizon_minutes",
            "grouping"
          ],
          "type": "object"
        }
      ]
    },
    "parent_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
