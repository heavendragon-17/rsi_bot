      "minItems": 1,
      "type": "array"
    },
    "falsification_conditions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "hypothesis": {
      "pattern": "\\S",
      "type": "string"
    },
