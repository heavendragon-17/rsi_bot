          },
          "required": [
            "mode",
            "event_index"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "fixture",
                "real"
              ],
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "grouping": {
              "enum": [
                "calendar_year",
                "trend",
                "volatility",
                "choose"
              ],
              "type": "string"
            },
            "horizon_minutes": {
              "enum": [
                60,
