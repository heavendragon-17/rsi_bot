{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qE '^git commit' && bash scripts/arch_lint_hook.sh || true",
            "timeout": 30,
            "statusMessage": "Running architecture lint..."
          }
        ]
      }
    ]
  }
}
